{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022"],
    // The hook shim and the fake engine are dependency-free ESM run by bare
    // `node` (no build step available to them), but ENGINEERING-STANDARDS §1
    // still owes them type safety: `@ts-check` + JSDoc, checked here.
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "src/main/**/*",
    "src/shared/**/*",
    "shims/**/*",
    "test/**/*",
    "electron.vite.config.ts",
    "vitest.config.mts"
  ],
  // Renderer render-tests are `.tsx` and belong to tsconfig.web-test.json:
  // this project has no `jsx` setting and no DOM lib on purpose.
  "exclude": ["test/renderer/**/*.tsx"]
}
