# Line endings are normalized to LF in the repository.
#
# Why this file exists: during M6, `docs/PROGRESS.md` entered the index with
# CRLF endings on a Windows checkout. Nothing was wrong with the content, but
# the milestone's diff read as 6582 changed lines where 248 had changed — and
# PROGRESS.md is the project's primary audit trail, the one document a
# close-out audit reads by diff. A record that cannot be reviewed by diff is
# where a substantive edit to an earlier milestone would hide.
#
# `core.autocrlf` is a per-machine setting and cannot be relied on; this file
# travels with the repository, so every clone agrees.

* text=auto eol=lf

# Binary assets — never touch these.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.mp3    binary
*.wav    binary
*.pdf    binary
*.zip    binary
*.sqlite binary

# Shell scripts and hooks must keep LF or they will not execute.
*.sh          text eol=lf
.githooks/*   text eol=lf
